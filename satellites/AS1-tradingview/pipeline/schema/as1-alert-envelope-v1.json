{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ailynx.local/schemas/as1-alert-envelope-v1.json",
  "title": "AiLynx Satellite 1 TradingView Alert Envelope v1",
  "description": "HORUS A, HORUS B, MAAT, MAAT2가 공통으로 보내는 확정 봉 알림 봉투입니다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "satellite_id", "platform", "layout_id", "observer",
    "code_version", "ticker_id", "symbol", "timeframe", "bar_open_time",
    "bar_close_time", "sent_at", "packet_type", "confirmed", "quality",
    "dedup_key", "payload"
  ],
  "properties": {
    "schema_version": { "const": "as1-alert-envelope-v1" },
    "satellite_id": { "const": "AS1" },
    "platform": { "const": "tradingview" },
    "layout_id": {
      "type": "string",
      "enum": ["horus-a", "horus-b", "maat", "maat2"]
    },
    "observer": {
      "type": "string",
      "minLength": 1,
      "description": "알림을 만든 관측기(스크립트 또는 허브)의 안정적인 이름"
    },
    "code_version": { "type": "string", "minLength": 1 },
    "ticker_id": {
      "type": "string",
      "minLength": 1,
      "description": "TradingView tickerid 원문. 예: BINANCE:BTCUSDT"
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "description": "사람이 읽기 쉬운 심볼. 예: BTCUSDT"
    },
    "timeframe": { "type": "string", "minLength": 1, "examples": ["15", "1H", "D"] },
    "bar_open_time": { "type": "string", "format": "date-time" },
    "bar_close_time": { "type": "string", "format": "date-time" },
    "sent_at": { "type": "string", "format": "date-time" },
    "packet_type": {
      "type": "string",
      "enum": ["bar_close_snapshot"],
      "description": "v1에서는 확정 봉의 최종 상태만 보냅니다."
    },
    "confirmed": {
      "const": true,
      "description": "확정 봉에서만 전송하므로 항상 true입니다."
    },
    "quality": {
      "type": "string",
      "enum": ["normal", "degraded"],
      "description": "normal=정상 계산, degraded=일부 레이아웃 고유 값이 준비되지 않음"
    },
    "dedup_key": {
      "type": "string",
      "pattern": "^.+\\|.+\\|.+\\|.+\\|as1-alert-envelope-v1$",
      "description": "layout_id|ticker_id|timeframe|bar_close_time|schema_version 순서의 멱등 키"
    },
    "payload": {
      "type": "object",
      "description": "공통 필드를 반복하지 않고 해당 레이아웃만의 계산 결과만 넣습니다."
    }
  }
}
