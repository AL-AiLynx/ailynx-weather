{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ailynx.local/schemas/as1-source-profile-registry-v1.3.json",
  "title": "AS1 Source Profile Registry v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "profiles"
  ],
  "properties": {
    "registry_version": {
      "const": "as1-source-profile-registry.v1.3"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_profile_code",
        "canonical_regime_id",
        "profile_status",
        "asset_class",
        "instrument_type",
        "ticker_id",
        "venue",
        "symbol",
        "base_asset",
        "quote_asset",
        "contract",
        "volume_unit",
        "volume_basis",
        "session_calendar_id",
        "session_timezone",
        "session_policy",
        "active_from_utc_ms",
        "active_to_utc_ms",
        "active_from_local_date",
        "active_to_local_date",
        "boundary_timezone",
        "boundary_precision",
        "price_comparison_group",
        "volume_comparison_group",
        "allowed_layouts",
        "notes"
      ],
      "properties": {
        "source_profile_code": {
          "type": "string"
        },
        "canonical_regime_id": {
          "type": "string"
        },
        "profile_status": {
          "enum": [
            "ACTIVE",
            "HISTORICAL",
            "DISABLED",
            "DRAFT"
          ]
        },
        "asset_class": {
          "enum": [
            "CRYPTO",
            "EQUITY",
            "INDEX",
            "COMMODITY",
            "FX",
            "FIXED_INCOME",
            "EVENT",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "instrument_type": {
          "enum": [
            "SPOT",
            "EQUITY",
            "ETF",
            "INDEX",
            "PERPETUAL",
            "FUTURE",
            "OPTION",
            "CFD",
            "FUND",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "ticker_id": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "base_asset": {
          "type": "string"
        },
        "quote_asset": {
          "type": "string"
        },
        "contract": {
          "$ref": "as1-common-types-v1.3.json#/$defs/contract"
        },
        "volume_unit": {
          "enum": [
            "BASE_ASSET",
            "QUOTE_ASSET",
            "CONTRACTS",
            "UNKNOWN"
          ]
        },
        "volume_basis": {
          "enum": [
            "EXCHANGE_NATIVE",
            "BASE_NORMALIZED",
            "QUOTE_NOTIONAL",
            "RELATIVE_NORMALIZED",
            "UNKNOWN"
          ]
        },
        "session_calendar_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_timezone": {
          "type": "string"
        },
        "session_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_policy_type",
            "session_calendar_id",
            "session_timezone",
            "default_expectation_state",
            "grace_seconds",
            "calendar_source"
          ],
          "properties": {
            "session_policy_type": {"enum": ["CONTINUOUS_24_7", "EXCHANGE_CALENDAR", "CUSTOM", "UNKNOWN"]},
            "session_calendar_id": {"type": ["string", "null"]},
            "session_timezone": {"type": "string"},
            "default_expectation_state": {"enum": ["EXPECTED", "NOT_EXPECTED", "UNKNOWN"]},
            "grace_seconds": {"type": "number", "minimum": 0},
            "calendar_source": {"enum": ["TRADINGVIEW_HINT", "REGISTRY_STATIC", "EXTERNAL_CALENDAR", "NONE", "UNKNOWN", "TEST_FIXTURE"]}
          }
        },
        "active_from_utc_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "active_to_utc_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "active_from_local_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "active_to_local_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "boundary_timezone": {
          "type": "string"
        },
        "boundary_precision": {
          "enum": [
            "EXACT",
            "DATE_ONLY",
            "UNKNOWN"
          ]
        },
        "price_comparison_group": {
          "type": "string"
        },
        "volume_comparison_group": {
          "type": "string"
        },
        "allowed_layouts": {
          "type": "array",
          "items": {
            "$ref": "as1-common-types-v1.3.json#/$defs/layoutId"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
