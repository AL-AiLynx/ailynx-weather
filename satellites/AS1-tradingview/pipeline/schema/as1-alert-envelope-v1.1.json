{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ailynx.local/schemas/as1-alert-envelope-v1.1.json",
  "title": "AiLynx Satellite 1 TradingView Alert Envelope v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "satellite_id", "platform", "layout_id", "observer", "code_version", "instrument", "timing", "bar", "packet_type", "confirmed", "quality", "dedup_key", "payload"],
  "properties": {
    "schema_version": {"const": "as1.v1.1"},
    "satellite_id": {"const": "AS1"},
    "platform": {"const": "TRADINGVIEW"},
    "layout_id": {"enum": ["HORUS_A", "HORUS_B", "MAAT", "MAAT2"]},
    "observer": {"type": "string", "minLength": 1},
    "code_version": {"type": "string", "minLength": 1},
    "instrument": {
      "type": "object", "additionalProperties": false,
      "required": ["ticker_id", "venue", "symbol", "base_asset", "quote_asset", "source_regime_id"],
      "properties": {
        "ticker_id": {"type": "string", "minLength": 1}, "venue": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1}, "base_asset": {"type": "string", "minLength": 1},
        "quote_asset": {"type": "string", "minLength": 1}, "source_regime_id": {"type": "string", "minLength": 1}
      }
    },
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["timeframe", "bar_open_time", "bar_close_time", "sent_at"],
      "properties": {
        "timeframe": {"type": "string", "minLength": 1},
        "bar_open_time": {"type": "integer", "minimum": 0}, "bar_close_time": {"type": "integer", "minimum": 0}, "sent_at": {"type": "integer", "minimum": 0}
      }
    },
    "bar": {
      "type": "object", "additionalProperties": false,
      "required": ["open", "high", "low", "close", "volume", "volume_unit"],
      "properties": {
        "open": {"type": "number"}, "high": {"type": "number"}, "low": {"type": "number"}, "close": {"type": "number"},
        "volume": {"type": ["number", "null"]},
        "volume_unit": {"enum": ["RAW_EXCHANGE_VOLUME", "BASE_ASSET", "QUOTE_NOTIONAL", "CONTRACTS", "UNKNOWN"]}
      }
    },
    "packet_type": {"const": "BAR_CLOSE_SNAPSHOT"}, "confirmed": {"const": true},
    "quality": {
      "type": "object", "additionalProperties": false,
      "required": ["sensor_quality", "freshness", "valid", "flags"],
      "properties": {
        "sensor_quality": {"enum": ["GOOD", "LIMITED", "WATCH", "INVALID"]}, "freshness": {"enum": ["FRESH", "AGING", "STALE"]},
        "valid": {"type": "boolean"},
        "flags": {"type": "array", "items": {"enum": ["MISSING_VOLUME", "MISSING_REQUIRED_FIELD", "FALLBACK_VALUE", "LTF_UNAVAILABLE", "PARTIAL_SOURCE", "TIMING_DELAY", "INVALID_NUMERIC_VALUE"]}, "uniqueItems": true}
      }
    },
    "dedup_key": {"type": "string", "pattern": "^AS1\\|(?:HORUS_A|HORUS_B|MAAT|MAAT2)\\|.+\\|.+\\|.+\\|[0-9]+\\|as1\\.v1\\.1$"},
    "payload": {"type": "object"}
  }
}
