{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ailynx.local/schemas/as1-alert-envelope-v1.2.json",
  "title": "AiLynx Satellite 1 Raw TradingView Alert Envelope v1.2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "satellite_id", "platform", "layout_id", "observer", "code_version", "source_profile_code", "instrument", "session_hint", "timing", "bar", "packet_type", "confirmed", "quality", "client_event_key", "payload"],
  "properties": {
    "schema_version": {"const": "as1.v1.2"}, "satellite_id": {"const": "AS1"}, "platform": {"const": "TRADINGVIEW"},
    "layout_id": {"enum": ["HORUS_A", "HORUS_B", "MAAT", "MAAT2"]}, "observer": {"type": "string", "minLength": 1}, "code_version": {"type": "string", "minLength": 1}, "source_profile_code": {"type": "string", "minLength": 1},
    "instrument": {"$ref": "#/$defs/instrument"}, "session_hint": {"$ref": "#/$defs/sessionHint"},
    "timing": {"type": "object", "additionalProperties": false, "required": ["timeframe", "bar_open_time", "bar_close_time", "sent_at"], "properties": {"timeframe": {"type": "string", "minLength": 1}, "bar_open_time": {"type": "integer", "minimum": 0}, "bar_close_time": {"type": "integer", "minimum": 0}, "sent_at": {"type": "integer", "minimum": 0}}},
    "bar": {"type": "object", "additionalProperties": false, "required": ["open", "high", "low", "close", "volume", "volume_unit", "volume_basis"], "properties": {"open": {"type": "number"}, "high": {"type": "number"}, "low": {"type": "number"}, "close": {"type": "number"}, "volume": {"type": ["number", "null"]}, "volume_unit": {"enum": ["BASE_ASSET", "QUOTE_ASSET", "CONTRACTS", "UNKNOWN"]}, "volume_basis": {"enum": ["EXCHANGE_NATIVE", "BASE_NORMALIZED", "QUOTE_NOTIONAL", "RELATIVE_NORMALIZED", "UNKNOWN"]}}},
    "packet_type": {"const": "BAR_CLOSE_SNAPSHOT"}, "confirmed": {"const": true},
    "quality": {"type": "object", "additionalProperties": false, "required": ["sensor_quality", "valid", "flags"], "properties": {"sensor_quality": {"enum": ["GOOD", "LIMITED", "WATCH", "INVALID"]}, "valid": {"type": "boolean"}, "flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["MISSING_VOLUME", "MISSING_REQUIRED_FIELD", "FALLBACK_VALUE", "LTF_UNAVAILABLE", "PARTIAL_SOURCE", "INVALID_NUMERIC_VALUE", "PROFILE_HINT_UNCERTAIN", "SESSION_HINT_UNCERTAIN", "CONTRACT_HINT_UNCERTAIN"]}}}},
    "client_event_key": {"type": "string", "pattern": "^AS1\\|(?:HORUS_A|HORUS_B|MAAT|MAAT2)\\|.+\\|.+\\|[0-9]+\\|as1\\.v1\\.2$"}, "payload": {"type": "object"}
  },
  "$defs": {
    "instrument": {"type": "object", "additionalProperties": false, "required": ["ticker_id", "venue", "symbol", "base_asset", "quote_asset", "asset_class", "market_type", "contract"], "properties": {"ticker_id": {"type": "string", "minLength": 1}, "venue": {"type": "string", "minLength": 1}, "symbol": {"type": "string", "minLength": 1}, "base_asset": {"type": "string", "minLength": 1}, "quote_asset": {"type": "string", "minLength": 1}, "asset_class": {"enum": ["CRYPTO", "EQUITY", "ETF", "INDEX", "FOREX", "COMMODITY", "FIXED_INCOME", "FUND", "OTHER", "UNKNOWN"]}, "market_type": {"enum": ["SPOT", "PERPETUAL", "FUTURE", "OPTION", "INDEX", "CFD", "UNKNOWN"]}, "contract": {"$ref": "#/$defs/contract"}, "extensions": {"type": "object"}}},
    "contract": {"type": "object", "additionalProperties": false, "required": ["contract_type", "expiry_kind", "expiry_time", "settlement_asset", "contract_multiplier", "continuous_series", "adjustment_mode", "adjustment_applied", "roll_state", "roll_event"], "properties": {"contract_type": {"enum": ["NONE", "LINEAR", "INVERSE", "QUANTO", "UNKNOWN"]}, "expiry_kind": {"enum": ["NONE", "PERPETUAL", "DATED", "UNKNOWN"]}, "expiry_time": {"type": ["integer", "null"], "minimum": 0}, "settlement_asset": {"type": ["string", "null"]}, "contract_multiplier": {"type": ["number", "null"]}, "continuous_series": {"type": "boolean"}, "adjustment_mode": {"enum": ["NONE", "BACK_ADJUSTED", "FORWARD_ADJUSTED", "RATIO_ADJUSTED", "UNKNOWN"]}, "adjustment_applied": {"type": "boolean"}, "roll_state": {"enum": ["NONE", "PRE_ROLL", "ROLLING", "POST_ROLL", "EXPIRED", "UNKNOWN"]}, "roll_event": {"type": "boolean"}}},
    "sessionHint": {"type": "object", "additionalProperties": false, "required": ["session_type", "session_state", "is_market_open"], "properties": {"session_type": {"enum": ["CONTINUOUS_24_7", "EXCHANGE_SESSION", "CUSTOM", "UNKNOWN"]}, "session_state": {"enum": ["OPEN", "PRE_MARKET", "REGULAR", "POST_MARKET", "CLOSED", "MAINTENANCE", "HALTED", "UNKNOWN"]}, "is_market_open": {"type": "boolean"}}}
  }
}
