{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://ailynx.local/schemas/as1-fusion-snapshot-v1.2.json", "title": "AiLynx Satellite 1 Fusion Snapshot v1.2", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "satellite_id", "instrument_key", "assembly_time", "fusion_status", "visibility_score", "component_states", "stale_layouts", "conflicting_layouts", "missing_layouts"],
  "properties": {"schema_version": {"const": "as1.fusion.v1.2"}, "satellite_id": {"const": "AS1"}, "instrument_key": {"type": "string"}, "assembly_time": {"type": "integer", "minimum": 0}, "fusion_status": {"enum": ["ALIGNED", "MIXED", "CONFLICT", "INSUFFICIENT"]}, "visibility_score": {"type": "number", "minimum": 0, "maximum": 100}, "component_states": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["layout_id", "ticker_id", "canonical_regime_id", "timeframe", "bar_close_time", "received_at", "age_seconds", "sensor_quality", "freshness", "valid", "dedup_key"], "properties": {"layout_id": {"enum": ["HORUS_A", "HORUS_B", "MAAT", "MAAT2"]}, "ticker_id": {"type": "string"}, "canonical_regime_id": {"type": "string"}, "timeframe": {"type": "string"}, "bar_close_time": {"type": "integer", "minimum": 0}, "received_at": {"type": "integer", "minimum": 0}, "age_seconds": {"type": "number", "minimum": 0}, "sensor_quality": {"enum": ["GOOD", "LIMITED", "WATCH", "INVALID"]}, "freshness": {"enum": ["FRESH", "AGING", "STALE"]}, "valid": {"type": "boolean"}, "dedup_key": {"type": "string"}}}}, "stale_layouts": {"type": "array", "items": {"enum": ["HORUS_A", "HORUS_B", "MAAT", "MAAT2"]}, "uniqueItems": true}, "conflicting_layouts": {"type": "array", "items": {"enum": ["HORUS_A", "HORUS_B", "MAAT", "MAAT2"]}, "uniqueItems": true}, "missing_layouts": {"type": "array", "items": {"enum": ["HORUS_A", "HORUS_B", "MAAT", "MAAT2"]}, "uniqueItems": true}}
}
