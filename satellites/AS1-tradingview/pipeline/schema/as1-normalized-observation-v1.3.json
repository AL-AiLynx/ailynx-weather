{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://ailynx.local/schemas/as1-normalized-observation-v1.3.json", "title": "AS1 Normalized Observation v1.3",
  "type": "object", "additionalProperties": false,
  "required": ["normalized_schema_version", "source_schema_version", "fixture_id", "normalized_observation_id", "raw_event_id", "satellite_id", "layout_id", "observer", "code_version", "source_profile_code", "canonical_regime_id", "instrument", "canonical_instrument", "series_segment_id", "registry_snapshot_version", "session_hint", "session_context", "timing", "bar", "quality", "server_evaluation", "dedup_key", "payload"],
  "properties": {
    "normalized_schema_version": {"const": "as1.normalized.v1.3"}, "source_schema_version": {"const": "as1.v1.3"}, "fixture_id": {"type": "string"}, "normalized_observation_id": {"type": "string", "minLength": 1}, "raw_event_id": {"type": "string", "minLength": 1},
    "satellite_id": {"const": "AS1"}, "layout_id": {"$ref": "as1-common-types-v1.3.json#/$defs/layoutId"}, "observer": {"type": "string"}, "code_version": {"type": "string"}, "source_profile_code": {"type": "string"}, "canonical_regime_id": {"type": "string"},
    "instrument": {"$ref": "as1-common-types-v1.3.json#/$defs/instrument"}, "canonical_instrument": {"$ref": "as1-common-types-v1.3.json#/$defs/instrument"}, "series_segment_id": {"type": ["string", "null"]}, "registry_snapshot_version": {"const": "as1-source-profile-registry.v1.3"},
    "session_hint": {"$ref": "as1-common-types-v1.3.json#/$defs/sessionHint"},
    "session_context": {"type": "object", "additionalProperties": false, "required": ["validated", "session_calendar_id", "session_timezone", "canonical_session_state", "expectation_state", "expected_next_observation_at", "freshness_deadline_at", "validation_flags"], "properties": {"validated": {"type": "boolean"}, "session_calendar_id": {"type": ["string", "null"]}, "session_timezone": {"type": "string"}, "canonical_session_state": {"enum": ["OPEN", "PRE_MARKET", "REGULAR", "POST_MARKET", "CLOSED", "MAINTENANCE", "HALTED", "UNKNOWN"]}, "expectation_state": {"enum": ["EXPECTED", "NOT_EXPECTED", "UNKNOWN"]}, "expected_next_observation_at": {"type": ["integer", "null"], "minimum": 0}, "freshness_deadline_at": {"type": ["integer", "null"], "minimum": 0}, "validation_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}},
    "timing": {"$ref": "as1-common-types-v1.3.json#/$defs/timing"}, "bar": {"$ref": "as1-common-types-v1.3.json#/$defs/bar"}, "quality": {"$ref": "as1-common-types-v1.3.json#/$defs/quality"},
    "server_evaluation": {"type": "object", "additionalProperties": false, "required": ["schema_valid", "registry_validation_status", "registry_validation_flags", "received_at", "delivery_delay_seconds", "age_seconds", "freshness", "accepted", "quarantine_reason"], "properties": {"schema_valid": {"type": "boolean"}, "registry_validation_status": {"enum": ["VALID", "WARN", "REJECT"]}, "registry_validation_flags": {"type": "array", "items": {"type": "string"}}, "received_at": {"type": "integer", "minimum": 0}, "delivery_delay_seconds": {"type": "number", "minimum": 0}, "age_seconds": {"type": "number", "minimum": 0}, "freshness": {"enum": ["FRESH", "AGING", "STALE", "NOT_EXPECTED"]}, "accepted": {"type": "boolean"}, "quarantine_reason": {"type": ["string", "null"]}}},
    "dedup_key": {"type": "string", "minLength": 1}, "payload": {"type": "object"}
  }
}
