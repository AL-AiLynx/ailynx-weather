{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ailynx.local/schemas/as1-alert-envelope-v1.3.json",
  "title": "AS1 Raw Alert Envelope v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "satellite_id",
    "platform",
    "layout_id",
    "observer",
    "code_version",
    "source_profile_code",
    "instrument",
    "session_hint",
    "timing",
    "bar",
    "packet_type",
    "confirmed",
    "quality",
    "client_event_key",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "as1.v1.3"
    },
    "satellite_id": {
      "const": "AS1"
    },
    "platform": {
      "const": "TRADINGVIEW"
    },
    "layout_id": {
      "$ref": "as1-common-types-v1.3.json#/$defs/layoutId"
    },
    "observer": {
      "type": "string",
      "minLength": 1
    },
    "code_version": {
      "type": "string",
      "minLength": 1
    },
    "source_profile_code": {
      "type": "string",
      "minLength": 1
    },
    "instrument": {
      "$ref": "as1-common-types-v1.3.json#/$defs/instrument"
    },
    "session_hint": {
      "$ref": "as1-common-types-v1.3.json#/$defs/sessionHint"
    },
    "timing": {
      "$ref": "as1-common-types-v1.3.json#/$defs/timing"
    },
    "bar": {
      "$ref": "as1-common-types-v1.3.json#/$defs/bar"
    },
    "packet_type": {
      "const": "BAR_CLOSE_SNAPSHOT"
    },
    "confirmed": {
      "const": true
    },
    "quality": {
      "$ref": "as1-common-types-v1.3.json#/$defs/quality"
    },
    "client_event_key": {
      "type": "string",
      "pattern": "^AS1\\|(?:HORUS_A|HORUS_B|MAAT|MAAT2)\\|.+\\|.+\\|[0-9]+\\|as1\\.v1\\.3$"
    },
    "payload": {
      "type": "object"
    }
  }
}
