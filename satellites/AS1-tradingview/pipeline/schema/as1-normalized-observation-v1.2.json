{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://ailynx.local/schemas/as1-normalized-observation-v1.2.json", "title": "AiLynx Satellite 1 Normalized Observation v1.2", "type": "object", "additionalProperties": false,
