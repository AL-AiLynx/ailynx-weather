{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://ailynx.local/schemas/as1-fusion-snapshot-v1.3.json", "title": "AS1 Fusion Snapshot v1.3",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "satellite_id", "instrument_key", "assembly_time", "fusion_status", "visibility_score", "visibility_state", "visibility_formula_version", "visibility_breakdown", "component_states", "expected_layouts", "not_expected_layouts", "missing_layouts", "stale_layouts", "invalid_layouts", "conflicting_layouts", "flags"],
  "properties": {
    "schema_version": {"const": "as1.fusion.v1.3"}, "satellite_id": {"const": "AS1"}, "instrument_key": {"type": "string"}, "assembly_time": {"type": "integer", "minimum": 0},
    "fusion_status": {"enum": ["ALIGNED", "MIXED", "CONFLICT", "INSUFFICIENT"]}, "visibility_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "visibility_state": {"enum": ["NORMAL", "DEGRADED", "POOR", "NOT_EXPECTED", "INSUFFICIENT"]}, "visibility_formula_version": {"const": "AS1_VIS_V1"},
    "visibility_breakdown": {"type": "object", "additionalProperties": false, "required": ["expected_count", "not_expected_count", "fresh_count", "aging_count", "stale_count", "missing_count", "invalid_count", "base_visibility", "coherence_factor", "component_scores", "rounding_mode"], "properties": {"expected_count": {"type": "integer", "minimum": 0}, "not_expected_count": {"type": "integer", "minimum": 0}, "fresh_count": {"type": "integer", "minimum": 0}, "aging_count": {"type": "integer", "minimum": 0}, "stale_count": {"type": "integer", "minimum": 0}, "missing_count": {"type": "integer", "minimum": 0}, "invalid_count": {"type": "integer", "minimum": 0}, "base_visibility": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "coherence_factor": {"enum": [1.0, 0.85, 0.6]}, "component_scores": {"type": "object", "additionalProperties": {"type": ["number", "null"], "minimum": 0, "maximum": 100}}, "rounding_mode": {"const": "DECIMAL_HALF_UP"}}},
    "component_states": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "expected_layouts": {"$ref": "#/$defs/layoutList"}, "not_expected_layouts": {"$ref": "#/$defs/layoutList"}, "missing_layouts": {"$ref": "#/$defs/layoutList"}, "stale_layouts": {"$ref": "#/$defs/layoutList"}, "invalid_layouts": {"$ref": "#/$defs/layoutList"}, "conflicting_layouts": {"$ref": "#/$defs/layoutList"},
    "flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["REGIME_MIXED_COMPONENTS", "CONTRACT_MIXED_COMPONENTS", "SERIES_SEGMENT_MIXED_COMPONENTS", "SESSION_CLOSED", "SESSION_HALTED", "PARTIAL_EXPECTED_SET", "EXPECTED_COMPONENT_MISSING", "STALE_COMPONENT_PRESENT", "INVALID_COMPONENT_PRESENT", "CROSS_ASSET_COMPONENTS", "INSUFFICIENT_COMPARABLE_COMPONENTS"]}}
  },
  "$defs": {
    "layoutList": {"type": "array", "uniqueItems": true, "items": {"$ref": "as1-common-types-v1.3.json#/$defs/layoutId"}},
    "component": {"type": "object", "additionalProperties": false, "required": ["layout_id", "normalized_observation_id", "raw_event_id", "ticker_id", "canonical_regime_id", "timeframe", "bar_close_time", "received_at", "expectation_state", "age_seconds", "sensor_quality", "freshness", "valid", "dedup_key", "contract_id", "series_segment_id"], "properties": {"layout_id": {"$ref": "as1-common-types-v1.3.json#/$defs/layoutId"}, "normalized_observation_id": {"type": "string"}, "raw_event_id": {"type": "string"}, "ticker_id": {"type": "string"}, "canonical_regime_id": {"type": "string"}, "timeframe": {"type": "string"}, "bar_close_time": {"type": "integer", "minimum": 0}, "received_at": {"type": "integer", "minimum": 0}, "expectation_state": {"enum": ["EXPECTED", "NOT_EXPECTED", "UNKNOWN"]}, "age_seconds": {"type": "number", "minimum": 0}, "sensor_quality": {"enum": ["GOOD", "LIMITED", "WATCH", "INVALID"]}, "freshness": {"enum": ["FRESH", "AGING", "STALE", "NOT_EXPECTED"]}, "valid": {"type": "boolean"}, "dedup_key": {"type": "string"}, "contract_id": {"type": ["string", "null"]}, "series_segment_id": {"type": ["string", "null"]}}}
  }
}
