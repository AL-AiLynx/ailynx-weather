{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://ailynx.local/schemas/as1-source-profile-registry-v1.2.json", "title": "AS1 Source Profile Registry v1.2", "type": "object", "additionalProperties": false,
