  "$defs": {"contract": {"type": "object", "additionalProperties": false, "required": ["contract_type", "expiry_kind", "expiry_time", "settlement_asset", "contract_multiplier", "continuous_series", "adjustment_mode", "adjustment_applied", "roll_state", "roll_event"], "properties": {"contract_type": {"enum": ["NONE", "LINEAR", "INVERSE", "QUANTO", "UNKNOWN"]}, "expiry_kind": {"enum": ["NONE", "PERPETUAL", "DATED", "UNKNOWN"]}, "expiry_time": {"type": ["integer", "null"]}, "settlement_asset": {"type": ["string", "null"]}, "contract_multiplier": {"type": ["number", "null"]}, "continuous_series": {"type": "boolean"}, "adjustment_mode": {"enum": ["NONE", "BACK_ADJUSTED", "FORWARD_ADJUSTED", "RATIO_ADJUSTED", "UNKNOWN"]}, "adjustment_applied": {"type": "boolean"}, "roll_state": {"enum": ["NONE", "PRE_ROLL", "ROLLING", "POST_ROLL", "EXPIRED", "UNKNOWN"]}, "roll_event": {"type": "boolean"}}}, "profile": {"type": "object", "additionalProperties": false, "required": ["source_profile_code", "canonical_regime_id", "profile_status", "asset_class", "ticker_id", "venue", "symbol", "base_asset", "quote_asset", "market_type", "contract", "volume_unit", "volume_basis", "session_policy", "active_from_utc_ms", "active_to_utc_ms", "active_from_local_date", "active_to_local_date", "boundary_timezone", "boundary_precision", "price_comparison_group", "volume_comparison_group", "allowed_layouts", "minimum_schema_version", "is_active", "notes"], "properties": {"source_profile_code": {"type": "string"}, "canonical_regime_id": {"type": "string"}, "profile_status": {"enum": ["ACTIVE", "HISTORICAL", "DISABLED", "DRAFT"]}, "asset_class": {"enum": ["CRYPTO", "EQUITY", "ETF", "INDEX", "FOREX", "COMMODITY", "FIXED_INCOME", "FUND", "OTHER", "UNKNOWN"]}, "ticker_id": {"type": "string"}, "venue": {"type": "string"}, "symbol": {"type": "string"}, "base_asset": {"type": "string"}, "quote_asset": {"type": "string"}, "market_type": {"enum": ["SPOT", "PERPETUAL", "FUTURE", "OPTION", "INDEX", "CFD", "UNKNOWN